# 每个模型档位必须显式选择 ark 或 generic。
MODEL_PROVIDER_CHEAP=ark
MODEL_PROVIDER_BALANCED=ark
MODEL_PROVIDER_STRONG=ark

# Volcengine Ark / Doubao。
ARK_API_KEY=your_volcengine_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_ID_CHEAP=your_cheap_model_id
ARK_MODEL_ID_BALANCED=your_balanced_model_id
ARK_MODEL_ID_STRONG=your_strong_model_id
ARK_IMAGE_MODEL_ID=doubao-seedream-4-5-251128

# 选择 generic 的档位使用以下配置。
MODEL_API_KEY=your_model_api_key
MODEL_BASE_URL=https://your_model_endpoint
MODEL_NAME_CHEAP=your_cheap_model
MODEL_NAME_BALANCED=your_balanced_model
MODEL_NAME_STRONG=your_strong_model

# 可选：使用独立图片供应商时必须完整设置。
# IMAGE_API_KEY=your_image_api_key
# IMAGE_BASE_URL=https://your_image_endpoint
# IMAGE_MODEL_ID=your_image_model_id
# IMAGE_PROVIDER_NAME=image-provider

# 可选超时。
# AI_PLANNER_TIMEOUT_MS=180000
# AI_HTML_TIMEOUT_MS=120000

# 浏览器 QA 默认开启，仅在本地排障时关闭。
# PAGE_QA_SCREENSHOTS_ENABLED=false
