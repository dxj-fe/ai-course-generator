# Optional per-tier provider routing. Accepted values: ark, generic.
# Without selectors, the legacy behavior remains: prefer Ark when ARK_API_KEY exists.
MODEL_PROVIDER_CHEAP=ark
MODEL_PROVIDER_BALANCED=ark
MODEL_PROVIDER_STRONG=ark

# Volcengine Ark / Doubao OpenAI-compatible API.
ARK_API_KEY=your_volcengine_ark_api_key
ARK_MODEL_ID=your_doubao_model_id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional Day 35 model routing overrides; missing tiers reuse ARK_MODEL_ID.
ARK_MODEL_ID_CHEAP=
ARK_MODEL_ID_BALANCED=
ARK_MODEL_ID_STRONG=
# Optional per-attempt Course Planner timeout (60000–300000); default 180000.
AI_PLANNER_TIMEOUT_MS=
# Optional HTML Engineer override in milliseconds (30000–300000); default 120000.
AI_HTML_TIMEOUT_MS=
# Browser QA is enabled by default; uncomment only for local troubleshooting.
# PAGE_QA_SCREENSHOTS_ENABLED=false
# Optional; defaults to doubao-seedream-4-5-251128 and reuses ARK_API_KEY.
ARK_IMAGE_MODEL_ID=doubao-seedream-4-5-251128

# Generic OpenAI-compatible provider. Also used by tiers selecting "generic".
MODEL_API_KEY=your_openai_compatible_api_key
MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL_NAME=your_model_name
# Optional Day 35 model routing overrides; missing tiers reuse MODEL_NAME.
MODEL_NAME_CHEAP=
MODEL_NAME_BALANCED=
MODEL_NAME_STRONG=

# Optional override for a separate OpenAI-compatible image provider.
# Uncomment all four values only when image generation does not reuse Ark.
# IMAGE_API_KEY=your_image_api_key
# IMAGE_BASE_URL=https://your-image-provider-endpoint/v1
# IMAGE_MODEL_ID=your_image_model_id
# IMAGE_PROVIDER_NAME=image-provider
