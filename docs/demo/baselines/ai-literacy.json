{
  "version": 2,
  "id": "ai-literacy",
  "name": "初中生 AI 素养",
  "prompt": "为初中生生成一门 5 页 AI 素养课程，依次说明 AI 能做什么与不能做什么、解释幻觉和事实核验、讨论隐私与偏见风险、完成一个安全使用判断任务并总结负责任使用原则。使用中文和专业简洁的视觉风格，不把 AI 描述成永远正确的人类。",
  "pageCount": 5,
  "expectedCourseRoles": [
    {
      "label": "建立 AI 素养学习目标",
      "allowedPageTypes": ["cover", "story_intro"],
      "allowedInteractionTypes": ["navigate"]
    },
    {
      "label": "讲解或组织 AI 能力、幻觉与风险",
      "allowedPageTypes": ["knowledge_card", "comparison", "timeline"],
      "allowedInteractionTypes": ["reveal", "explore", "sort", "none"]
    },
    {
      "label": "形成可观察的安全使用判断",
      "allowedPageTypes": ["quiz", "achievement", "summary"],
      "allowedInteractionTypes": ["choice", "sort", "input"]
    },
    {
      "label": "收束负责任使用原则",
      "allowedPageTypes": ["summary", "achievement"],
      "allowedInteractionTypes": ["none", "navigate", "input", "choice"]
    }
  ],
  "requiredConcepts": [
    { "label": "AI 能力边界", "anyOf": ["能力边界", "能做什么", "不能做什么", "人工智能"] },
    { "label": "幻觉与核验", "anyOf": ["幻觉", "事实核验", "验证信息", "核验"] },
    { "label": "隐私风险", "anyOf": ["隐私", "个人信息"] },
    { "label": "偏见风险", "anyOf": ["偏见", "公平", "歧视"] },
    { "label": "安全负责使用", "anyOf": ["安全使用", "负责任", "负责使用"] }
  ],
  "quality": {
    "minOverallScore": 85,
    "minDimensionScore": 80,
    "requireScreenshotEvidence": true
  },
  "manualReview": {
    "minimumTotal": 24,
    "minimumDimension": 3
  }
}
