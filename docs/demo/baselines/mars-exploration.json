{
  "version": 2,
  "id": "mars-exploration",
  "name": "火星探险任务",
  "prompt": "为 10–12 岁学生生成一门 5 页《火星探险任务》课程，依次建立探险情境、解释火星环境、分析生存挑战、完成一道选择题并总结探险方案。必须讲到稀薄大气、低温、水或氧气等生存资源，使用中文和轻松但科学准确的科幻风格。",
  "pageCount": 5,
  "expectedCourseRoles": [
    {
      "label": "建立火星探险任务",
      "allowedPageTypes": ["cover", "story_intro"],
      "allowedInteractionTypes": ["navigate"]
    },
    {
      "label": "讲解或组织火星环境与生存资源",
      "allowedPageTypes": ["knowledge_card", "comparison", "timeline"],
      "allowedInteractionTypes": ["reveal", "explore", "sort", "none"]
    },
    {
      "label": "形成可观察的生存判断",
      "allowedPageTypes": ["quiz", "achievement", "summary"],
      "allowedInteractionTypes": ["choice", "sort", "input"]
    },
    {
      "label": "收束并迁移探险方案",
      "allowedPageTypes": ["summary", "achievement"],
      "allowedInteractionTypes": ["none", "navigate", "input", "choice"]
    }
  ],
  "requiredConcepts": [
    { "label": "火星主题", "anyOf": ["火星", "mars"] },
    { "label": "稀薄大气", "anyOf": ["稀薄大气", "大气稀薄", "二氧化碳"] },
    { "label": "低温环境", "anyOf": ["低温", "寒冷", "温度"] },
    { "label": "生存资源", "anyOf": ["水", "氧气", "食物", "生存资源"] }
  ],
  "quality": {
    "minOverallScore": 85,
    "minDimensionScore": 80,
    "requireScreenshotEvidence": true
  },
  "manualReview": {
    "minimumTotal": 24,
    "minimumDimension": 3
  }
}
