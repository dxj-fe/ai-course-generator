{
  "name": "keya-course-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --import tsx scripts/run-with-course-worker.ts dev",
    "dev:web": "next dev",
    "build": "next build",
    "browser:install": "playwright install --with-deps chromium",
    "demo:check": "node --import tsx scripts/check-course.ts",
    "demo:run": "node --import tsx scripts/run-demo.ts",
    "quality:compare": "node --import tsx scripts/compare-course-quality.ts",
    "quality:blind": "node --import tsx scripts/prepare-blind-review.ts",
    "worker:course": "node --import tsx scripts/course-task-worker.ts",
    "start": "node --import tsx scripts/run-with-course-worker.ts start",
    "start:web": "next start",
    "lint": "eslint",
    "prompt:lint": "node --experimental-strip-types scripts/prompt-lint.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.16",
    "ai": "7.0.40",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.1",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.4",
    "@ai-sdk/provider-utils": "5.0.14",
    "@next/env": "16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
